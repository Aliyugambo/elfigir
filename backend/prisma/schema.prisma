generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  phone              String?             @unique
  passwordHash       String
  firstName          String
  lastName           String
  profileImage       String?
  address            String?
  city               String?
  state              String?
  country            String?
  zipCode            String?
  role               UserRole            @default(CUSTOMER)
  isActive           Boolean             @default(true)
  emailVerified      Boolean             @default(false)
  phoneVerified      Boolean             @default(false)
  googleId           String?             @unique
  restaurantId       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  addresses          Address[]
  emailVerifications EmailVerification[]
  favorites          Favorite[]
  notifications      Notification[]
  orders             Order[]
  deliveryOrders     Order[]             @relation("DeliveryRider")
  trackingUpdates    DeliveryTracking[]
  reviews            Review[]
  restaurant         Restaurant?         @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId], map: "users_restaurantId_fkey")
  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  isDefault Boolean  @default(false)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, isDefault])
  @@map("addresses")
}

model Restaurant {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  description     String?
  logo            String?
  banner          String?
  image           String?
  cuisineType     String     @db.LongText
  rating          Float      @default(0)
  reviewCount     Int        @default(0)
  minDeliveryTime Int
  maxDeliveryTime Int
  deliveryFee     Float
  minOrderValue   Float      @default(0)
  address         String
  city            String
  state           String
  phone           String
  email           String?
  latitude        Float
  longitude       Float
  isOpen          Boolean    @default(true)
  isVerified      Boolean    @default(false)
  isActive        Boolean    @default(true)
  bankName        String?
  accountNumber   String?
  accountName     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  favorites       Favorite[]
  menus           Menu[]
  orders          Order[]
  reviews         Review[]
  staff           User[]

  @@map("restaurants")
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  items        MenuItem[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId], map: "menus_restaurantId_fkey")
  @@map("menus")
}

model MenuItem {
  id            String      @id @default(cuid())
  menuId        String
  name          String
  description   String?
  image         String?
  price         Float
  originalPrice Float?
  category      String
  isAvailable   Boolean     @default(true)
  prepTime      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  addOns        AddOn[]
  menu          Menu        @relation(fields: [menuId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([menuId], map: "menu_items_menuId_fkey")
  @@map("menu_items")
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Float
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId], map: "add_ons_menuItemId_fkey")
  @@map("add_ons")
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  userId                String
  restaurantId          String
  tracking              DeliveryTracking?
  status                OrderStatus       @default(PENDING)
  subtotal              Float
  deliveryFee           Float
  tax                   Float
  discount              Float             @default(0)
  totalAmount           Float
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus     @default(PENDING)
  deliveryAddress       String
  deliveryLat           Float?
  deliveryLng           Float?
  specialInstructions   String?
  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  riderId               String?
  rider                 User?             @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: SetNull)
  cancelReason          String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  items                 OrderItem[]
  restaurant            Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                  User              @relation(fields: [userId], references: [id])

  @@index([restaurantId], map: "orders_restaurantId_fkey")
  @@index([userId], map: "orders_userId_fkey")
  @@map("orders")
}

model DeliveryTracking {
  id             String    @id @default(cuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId        String
  rider          User      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  heading        Float?
  speed          Float?
  distanceMeters Int?
  etaSeconds     Int?
  arrivedAt      DateTime?
  lastUpdatedAt  DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@index([riderId])
  @@map("delivery_tracking")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  menuItemId  String
  quantity    Int
  price       Float
  addOns      String   @db.LongText
  specialNote String?
  createdAt   DateTime @default(now())
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([menuItemId], map: "order_items_menuItemId_fkey")
  @@index([orderId], map: "order_items_orderId_fkey")
  @@map("order_items")
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  rating       Int
  comment      String?
  foodQuality  Int?
  delivery     Int?
  packaging    Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId], map: "reviews_restaurantId_fkey")
  @@map("reviews")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId], map: "favorites_restaurantId_fkey")
  @@map("favorites")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verifications_userId_fkey")
  @@map("email_verifications")
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  STAFF
  ADMIN
  SUPER_ADMIN
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_ON_DELIVERY
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}
