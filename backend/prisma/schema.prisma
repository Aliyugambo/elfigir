generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  firstName     String
  lastName      String
  profileImage  String?
  address       String?
  city          String?
  state         String?
  country       String?
  zipCode       String?
  role          UserRole @default(CUSTOMER)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  restaurantId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orders             Order[]
  reviews            Review[]
  favorites          Favorite[]
  addresses          Address[]
  notifications      Notification[]
  emailVerifications EmailVerification[]
  restaurant         Restaurant?         @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Home", "Office", etc.
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  isDefault Boolean  @default(false)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, isDefault])
  @@map("addresses")
}

model Restaurant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  logo            String?
  banner          String?
  image           String?
  cuisineType     String[] // ["Italian", "Chinese", etc.]
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  minDeliveryTime Int // minutes
  maxDeliveryTime Int // minutes
  deliveryFee     Float
  minOrderValue   Float    @default(0)
  address         String
  city            String
  state           String
  phone           String
  email           String?
  latitude        Float
  longitude       Float
  isOpen          Boolean  @default(true)
  isVerified      Boolean  @default(false)
  isActive        Boolean  @default(true)
  bankName        String?
  accountNumber   String?
  accountName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  menus     Menu[]
  orders    Order[]
  reviews   Review[]
  favorites Favorite[]
  staff     User[]

  @@map("restaurants")
}

model Menu {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("menus")
}

model MenuItem {
  id            String   @id @default(cuid())
  menuId        String
  menu          Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  image         String?
  price         Float
  originalPrice Float?
  category      String
  isAvailable   Boolean  @default(true)
  prepTime      Int? // minutes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orderItems OrderItem[]
  addOns     AddOn[]

  @@map("menu_items")
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Float
  createdAt  DateTime @default(now())

  @@map("add_ons")
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  restaurantId          String
  restaurant            Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  status                OrderStatus   @default(PENDING)
  subtotal              Float
  deliveryFee           Float
  tax                   Float
  discount              Float         @default(0)
  totalAmount           Float
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  deliveryAddress       String
  deliveryLat           Float?
  deliveryLng           Float?
  specialInstructions   String?
  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  cancelReason          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  quantity    Int
  price       Float
  addOns      String[] // JSON string of selected add-ons
  specialNote String?
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rating       Int // 1-5
  comment      String?
  foodQuality  Int? // 1-5
  delivery     Int? // 1-5
  packaging    Int? // 1-5
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([userId, restaurantId])
  @@map("reviews")
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
  @@map("favorites")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // "order_update", "promo", etc.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  STAFF
  ADMIN
  SUPER_ADMIN
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH_ON_DELIVERY
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}
